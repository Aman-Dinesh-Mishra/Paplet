{
  "root": true,
  "env": {
    "es2022": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "overrides": [
    {
      "files": ["apps/api/src/**/*.ts"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["apps/web/src/**/*.{ts,tsx}"],
      "env": {
        "browser": true
      }
    }
  ]
}
